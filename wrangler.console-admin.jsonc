{
  // コンソールログインの Admin の Worker（docs/specs/console-login-portal.md §3・§8・§9）。MCP 用の wrangler.jsonc・Standard の wrangler.console-standard.jsonc とは別の Worker。
  // これは上流の「例」。下流は自前の wrangler.<name>-console-admin.jsonc を書き、routes・vars を自分の値にする（このファイルは編集しない）。
  // 入口は自社ドメインの Custom Domain だけ。workers_dev と Preview URL は無効（Access を経由しない入口を閉じる。console-login.md §5 の T11）。
  //   Admin のポータルのホスト（設定の portal.adminOrigin。ホスト方式ならチームごとの <team>.<host> も）だけ。issuer のホストは持たない。
  //   Admin の issuer の文書（openid-configuration と jwks.json）はこの Worker から出さない（AWS 側に置く。G1 の決裁 I-C）。
  //   チームのパス（パス方式 /t/<team>/...、ホスト方式 <team>.<host>/...）以外は、処理の最初に 404（env も Access JWT も見ない）。
  // 生成物: mise run console:config:generate が書く .generated/console/worker.admin.json（gitignore）を alias で読む。
  //   Standard の生成物（worker.standard.json）と表示用（display.standard.json）はここでは読まない。
  // 署名: 署名の経路（KMS・署名役の呼び出し・Admin のプロバイダーの URL）はまだ無い（G1-b）。ログインの最後の段は 503 signing_unavailable で止まり、STS を呼ばない。
  //   署名鍵の secret（CONSOLE_SIGNING_KEYS）は持たない。
  // secret（wrangler secret put。値はここに書かない）:
  //   CONSOLE_CSRF_KEY      CSRF トークンの HMAC の鍵（32 バイト以上のランダムな文字列。Standard の Worker と別の値にする）
  // vars:
  //   ACCESS_TEAM_DOMAIN    Access のチームドメイン（https://<team>.cloudflareaccess.com）
  //   LOGIN_DISABLED        停止スイッチ。"false" 以外（"true" など）にすると発行を止める（503 login_disabled）
  //   STS_REGION            STS の地域の endpoint（sts.<region>.amazonaws.com）。署名の経路が入ったあとに使う
  // ratelimits: 利用者（Access の sub）ごとの発行の回数の制限。値は仮の既定（G3 で確定）。namespace_id はアカウント内で一意の数字の文字列（Standard の Worker と別の値）。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awsbridge-console-admin",
  "main": "src/console/admin/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "admin-portal.example.com", "custom_domain": true }],
  "alias": { "awsbridge:console-worker-admin": "./.generated/console/worker.admin.json" },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://example.cloudflareaccess.com",
    "LOGIN_DISABLED": "false",
    "STS_REGION": "us-east-1"
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
