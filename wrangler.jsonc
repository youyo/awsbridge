{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awsbridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // ISSUER (public URL of the Worker) is passed at deploy time with `--var ISSUER:<url>`; it is not stored in this repo.
  // Secrets (SIGNING_JWK, ADDITIONAL_PUBLIC_JWKS, ACCESS_TEAM_DOMAIN, ACCESS_AUD, AWS_PROFILES) are registered with `mise run secrets` (wrangler secret bulk).
  // AWS_PROFILES (the accounts selectable with `aws_profile`) can instead be a plain var. Downstream repositories do not edit this file:
  // they add their own `wrangler.<name>.jsonc` (see README_ja.md "下流リポジトリでの運用") and select it with AWSBRIDGE_WRANGLER_CONFIG.
  // (a JSON object; do not also register it as a secret). Example with dummy values (see README_ja.md "マルチアカウント").
  // `profiles` is an array (recommended): its order becomes the order of the `aws_profile` enum (the default profile always comes first).
  // An object keyed by profile name is also accepted, but the key order may not survive until the tools list is built.
  //   "vars": { "AWS_PROFILES": { "default": "dev-readonly", "profiles": [
  //     { "name": "dev-readonly",  "roleArn": "arn:aws:iam::111111111111:role/FederatedMcpReadOnly", "description": "development (read-only)" },
  //     { "name": "dev-debug",     "roleArn": "arn:aws:iam::111111111111:role/FederatedMcpDebug", "description": "development (debug)" },
  //     { "name": "prod-readonly", "roleArn": "arn:aws:iam::222222222222:role/FederatedMcpReadOnly" },
  //     { "name": "prod-debug",    "roleArn": "arn:aws:iam::222222222222:role/FederatedMcpDebug" } ] } }
  "env": {
    "dev": {
      "name": "awsbridge-dev",
      "workers_dev": true
    }
  }
}
