{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awsbridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // ISSUER (public URL of the Worker) is passed at deploy time with `--var ISSUER:<url>`; it is not stored in this repo.
  // Secrets (SIGNING_JWK, ACCESS_TEAM_DOMAIN, ACCESS_AUD, FEDERATED_ROLE_ARN) are registered with `mise run secrets` (wrangler secret bulk).
  "env": {
    "dev": {
      "name": "awsbridge-dev",
      "workers_dev": true
    }
  }
}
